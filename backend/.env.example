# Copy to .env and fill in real values.  Generate secrets with:
#   node scripts/gen-secret.js "your-strong-password"

PORT=4000

# REQUIRED in production. Long random string. Generate with gen-secret.js.
JWT_SECRET=change_this_to_a_long_random_secret

# Admin login
ADMIN_USERNAME=admin
# Use a bcrypt HASH (recommended). Generate with gen-secret.js.
# ADMIN_PASSWORD_HASH=$2b$12$....
# Fallback plain password (only if no hash set). MUST be strong in production.
ADMIN_PASSWORD=noor1234

# Restrict CORS in production (comma-separated). Empty = allow all (dev only).
# ALLOWED_ORIGINS=https://noorstudiogorgan.ir

# Set in production so the server enforces the security checks above.
# NODE_ENV=production

# Optional: override SQLite file location
# DB_FILE=/var/www/noor-studio/backend/noor.db
