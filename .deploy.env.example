# Copy this file to .deploy.env and fill in local-only values.
# .deploy.env is ignored by git.

SSH_HOST="87.248.156.107"
SSH_PORT="9011"
SSH_USER="root"

APP_DIR="/var/www/noor-studio"
# WEBROOT must match the nginx `root` for the site (it serves dist/, not the app dir).
WEBROOT="/var/www/noor-studio/dist"
SERVICE_NAME="noor-backend"

# Set SKIP_NPM=1 when the server has no outbound internet (this VPS doesn't):
# the npm step would wipe node_modules then fail to reinstall offline.
# SKIP_NPM=1

# 0 = deploy code only and keep the server database/uploads.
# 1 = replace server database/uploads with your local backend/noor.db and backend/uploads.
SYNC_LOCAL_DATA="0"

# Required only when SYNC_LOCAL_DATA="1".
# This extra switch prevents accidental replacement of production content.
DEPLOY_REPLACE_SERVER_DATA="no"

# Optional. Prefer SSH keys when possible.
# If you set this, install sshpass first:
# brew install hudochenkov/sshpass/sshpass
DEPLOY_SSH_PASSWORD="your-server-password"
